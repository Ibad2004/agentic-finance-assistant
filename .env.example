GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/accounting_agent
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GROQ_MODEL=openai/gpt-oss-120b
TRANSACTION_AGENT_BATCH_SIZE=10
TRANSACTION_AGENT_CONFIDENCE_THRESHOLD=0.85
TRANSACTION_AGENT_MAX_BATCHES_PER_RUN=10
